'''
Runs the post-merge githooks.
'''

import os
import subprocess
import sys

SRC_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
FLUTTER_DIR = os.path.join(SRC_ROOT, 'flutter')


def IsWindows():
  return sys.platform.startswith('win32') or sys.platform.startswith('cygwin')


def GetDartBin():
  dart_bin = os.path.join(SRC_ROOT, 'flutter', 'third_party', 'dart', 'tools', 'sdks', 'dart-sdk', 'bin')
  if not os.path.exists(dart_bin):
    dart_bin = os.path.join(SRC_ROOT, 'third_party', 'dart', 'tools', 'sdks', 'dart-sdk', 'bin')
  return dart_bin


def Main(argv):
  # A worktree without `gclient sync` has neither the Dart SDK nor the package
  # config this hook runs with. It has nothing to check, so don't fail the git
  # command it runs under.
  package_config = os.path.join(FLUTTER_DIR, '.dart_tool', 'package_config.json')
  dart = os.path.join(GetDartBin(), 'dart.exe' if IsWindows() else 'dart')
  if not os.path.exists(dart) or not os.path.exists(package_config):
    return 0

  githook_args = [
    '--flutter',
    FLUTTER_DIR,
  ]

  result = subprocess.run([
    dart,
    os.path.join(FLUTTER_DIR, 'tools', 'githooks', 'bin', 'main.dart'),
  ] + githook_args + [
    'post-merge',
  ] + argv[1:], cwd=SRC_ROOT)
  return result.returncode


if __name__ == '__main__':
    sys.exit(Main(sys.argv))
