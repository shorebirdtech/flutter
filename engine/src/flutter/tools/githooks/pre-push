'''
Runs the pre-push githooks.
'''

import os
import subprocess
import sys


# core.hooksPath is an absolute path shared by every worktree of the
# repository, so this script may belong to a different worktree than the one
# being pushed. Git runs hooks from the root of the worktree being pushed, so
# check that one rather than the one this script lives in.
REPO_ROOT = subprocess.run(['git', 'rev-parse', '--show-toplevel'],
                           check=True, capture_output=True, text=True).stdout.strip()
SRC_ROOT = os.path.join(REPO_ROOT, 'engine', 'src')
FLUTTER_DIR = os.path.join(SRC_ROOT, 'flutter')
ENABLE_CLANG_TIDY = os.environ.get('PRE_PUSH_CLANG_TIDY')


def GetDartBin():
  dart_bin = os.path.join(SRC_ROOT, 'flutter', 'third_party', 'dart', 'tools', 'sdks', 'dart-sdk', 'bin')
  if not os.path.exists(dart_bin):
    dart_bin = os.path.join(SRC_ROOT, 'third_party', 'dart', 'tools', 'sdks', 'dart-sdk', 'bin')
  return dart_bin


def Main(argv):
  # A worktree without `gclient sync` has neither the Dart SDK nor the package
  # config the checks run with.
  package_config = os.path.join(FLUTTER_DIR, '.dart_tool', 'package_config.json')
  if not os.path.exists(os.path.join(GetDartBin(), 'dart')) or not os.path.exists(package_config):
    print('\033[1m\033[31mWarning:\033[0m \033[1mPre-push checks skipped: %s is not synced.\033[0m' % REPO_ROOT)
    print('\033[1m\033[33mNote:\033[0m \033[1mRun "gclient sync -D" in %s to enable them.\033[0m' % SRC_ROOT)
    return 0

  githook_args = [
    '--flutter',
    FLUTTER_DIR,
  ]

  if ENABLE_CLANG_TIDY is not None:
    githook_args += [
      '--enable-clang-tidy',
    ]

  result = subprocess.run([
    os.path.join(GetDartBin(), 'dart'),
    os.path.join(FLUTTER_DIR, 'tools', 'githooks', 'bin', 'main.dart'),
  ] + githook_args + [
    'pre-push',
  ] + argv[1:], cwd=SRC_ROOT)
  return result.returncode


if __name__ == '__main__':
    sys.exit(Main(sys.argv))
