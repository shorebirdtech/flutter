import("//flutter/build/dart/dart.gni")
import("//flutter/common/config.gni")

import("$dart_src/build/dart/copy_tree.gni")

if (build_engine_artifacts) {
  if (flutter_prebuilt_dart_sdk) {
    copy_tree("dart_sdk") {
      source = prebuilt_dart_sdk
      dest = "$root_out_dir/dart-sdk"

      # A dep_type gcs prebuilt leaves gclient's download (.<object>.tar.gz)
      # and its bookkeeping files (.<object>_tar_gz_*) beside the SDK.
      exclude = ".*.tar.gz,.*_tar_gz_*"
    }
  } else {
    group("dart_sdk") {
      public_deps = [ "$dart_src:create_sdk" ]
    }
  }
}
