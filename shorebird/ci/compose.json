{
  "ios-framework": {
    "requires": ["ios"],
    "script": "flutter/sky/tools/create_ios_framework.py",
    "flags": ["--dsym", "--strip", "--no-extension-safe-frameworks"],
    "path_args": {
      "--arm64-out-dir": "ios_release",
      "--simulator-x64-out-dir": "ios_debug_sim",
      "--simulator-arm64-out-dir": "ios_debug_sim_arm64"
    },
    "artifacts": [
      {"src": "artifacts.zip", "dst": "flutter_infra_release/flutter/$engine/ios-release/artifacts.zip"},
      {"src": "Flutter.framework.dSYM.zip", "dst": "flutter_infra_release/flutter/$engine/ios-release/Flutter.framework.dSYM.zip"}
    ]
  },
  "macos-framework": {
    "requires": ["mac-arm64", "mac-x64"],
    "script": "flutter/sky/tools/create_macos_framework.py",
    "flags": ["--dsym", "--strip", "--zip"],
    "path_args": {
      "--arm64-out-dir": "mac_release_arm64",
      "--x64-out-dir": "mac_release"
    },
    "artifacts": [
      {"src": "framework.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64-release/framework.zip"},
      {"src": "FlutterMacOS.framework.dSYM.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64/FlutterMacOS.framework.dSYM.zip"}
    ]
  },
  "macos-gen-snapshot": {
    "requires": ["mac-arm64", "mac-x64"],
    "script": "flutter/sky/tools/create_macos_gen_snapshots.py",
    "flags": ["--zip"],
    "path_args": {
      "--arm64-path": "mac_release_arm64/universal/gen_snapshot_arm64",
      "--x64-path": "mac_release/universal/gen_snapshot_x64"
    },
    "dst": "release/snapshot",
    "artifacts": [
      {"src": "snapshot/gen_snapshot.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64-release/gen_snapshot.zip"}
    ]
  },
  "macos-framework-debug": {
    "requires": ["mac-arm64-debug", "mac-x64-debug"],
    "script": "flutter/sky/tools/create_macos_framework.py",
    "flags": ["--zip"],
    "path_args": {
      "--arm64-out-dir": "mac_debug_arm64",
      "--x64-out-dir": "mac_debug"
    },
    "dst": "release/debug",
    "artifacts": [
      {"src": "debug/framework.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64/framework.zip"}
    ]
  },
  "macos-gen-snapshot-debug": {
    "requires": ["mac-arm64-debug", "mac-x64-debug"],
    "script": "flutter/sky/tools/create_macos_gen_snapshots.py",
    "flags": ["--zip"],
    "path_args": {
      "--arm64-path": "mac_debug_arm64/universal/gen_snapshot_arm64",
      "--x64-path": "mac_debug/universal/gen_snapshot_x64"
    },
    "dst": "release/debug/snapshot",
    "artifacts": [
      {"src": "debug/snapshot/gen_snapshot.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64/gen_snapshot.zip"}
    ]
  },
  "macos-framework-profile": {
    "requires": ["mac-arm64-profile", "mac-x64-profile"],
    "script": "flutter/sky/tools/create_macos_framework.py",
    "flags": ["--zip"],
    "path_args": {
      "--arm64-out-dir": "mac_profile_arm64",
      "--x64-out-dir": "mac_profile"
    },
    "dst": "release/profile",
    "artifacts": [
      {"src": "profile/framework.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64-profile/framework.zip"}
    ]
  },
  "macos-gen-snapshot-profile": {
    "requires": ["mac-arm64-profile", "mac-x64-profile"],
    "script": "flutter/sky/tools/create_macos_gen_snapshots.py",
    "flags": ["--zip"],
    "path_args": {
      "--arm64-path": "mac_profile_arm64/universal/gen_snapshot_arm64",
      "--x64-path": "mac_profile/universal/gen_snapshot_x64"
    },
    "dst": "release/profile/snapshot",
    "artifacts": [
      {"src": "profile/snapshot/gen_snapshot.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64-profile/gen_snapshot.zip"}
    ]
  },
  "ios-framework-debug": {
    "requires": ["ios"],
    "script": "flutter/sky/tools/create_ios_framework.py",
    "flags": ["--no-extension-safe-frameworks"],
    "path_args": {
      "--arm64-out-dir": "ios_debug",
      "--simulator-x64-out-dir": "ios_debug_sim",
      "--simulator-arm64-out-dir": "ios_debug_sim_arm64"
    },
    "dst": "release/debug",
    "artifacts": [
      {"src": "debug/artifacts.zip", "dst": "flutter_infra_release/flutter/$engine/ios/artifacts.zip"}
    ]
  },
  "ios-framework-profile": {
    "requires": ["ios"],
    "script": "flutter/sky/tools/create_ios_framework.py",
    "flags": ["--no-extension-safe-frameworks"],
    "path_args": {
      "--arm64-out-dir": "ios_profile",
      "--simulator-x64-out-dir": "ios_debug_sim",
      "--simulator-arm64-out-dir": "ios_debug_sim_arm64"
    },
    "dst": "release/profile",
    "artifacts": [
      {"src": "profile/artifacts.zip", "dst": "flutter_infra_release/flutter/$engine/ios-profile/artifacts.zip"}
    ]
  }
}
