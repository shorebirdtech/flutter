        "type": "shell",
        "command": "mkdir -p out/ci/host_release/aot_tools && out/ci/host_release/dart-sdk/bin/dart pub get --offline --directory=flutter/third_party/dart/pkg/aot_tools && out/ci/host_release/dart-sdk/bin/dart compile kernel flutter/third_party/dart/pkg/aot_tools/bin/aot_tools.dart -o out/ci/host_release/aot_tools/aot-tools.dill"
