        "type": "builder",
        "builds": ["mac_android_aot_engine/ci/android_release_arm64"],
        "gn_args": {
          "add": ["--gn-args=host_cpu=\"x64\""],
          "why": "Upstream's Mac Android AOT bots are x64 (drone cpu=x86); ours are arm64, and the published darwin-x64 gen_snapshot must be x64."
        },
        "ninja_targets": {
          "remove": ["flutter/lib/snapshot"],
          "why": "Not published from this shard (its artifacts and composes say what is), so not worth the compile minutes."
