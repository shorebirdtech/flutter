  "mac-arm64": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--runtime-mode=release", "--mac-cpu=arm64"],
        "ninja_targets": ["dart_sdk"],
        "out_dir": "host_release_arm64"
      },
      {
        "type": "builder",
        "builds": ["mac_host_engine/ci/mac_release_arm64", "mac_host_engine/ci/mac_release_framework_arm64"],
        "ninja_targets": {
          "add": ["flutter/lib/snapshot:generate_snapshot_bins"],
          "why": "What this shard's artifacts, composes or later steps need that upstream's build doesn't list."
        }
      }
    ],
    "compose_input": "macos-framework",
    "artifacts": [
      {"src": "host_release_arm64/dart-sdk", "dst": "flutter_infra_release/flutter/$engine/dart-sdk-darwin-arm64.zip", "zip": true, "content_hash": true},
      {"src": "ci/mac_release_arm64/zip_archives/darwin-arm64-release/artifacts.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64-release/artifacts.zip"},
      {"src": "ci/mac_release_arm64/zip_archives/darwin-arm64/font-subset.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-arm64/font-subset.zip"},
      {"src": "ci/mac_release_arm64/analyze_snapshot_arm64", "dst": "shorebird/$engine/analyze-snapshot-macos-arm64"}
    ]
  },
  "mac-x64": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--runtime-mode=release", "--mac-cpu=x64"],
        "ninja_targets": ["dart_sdk"],
        "out_dir": "host_release"
      },
      {
        "type": "builder",
        "builds": ["mac_host_engine/ci/host_release", "mac_host_engine/ci/host_release_framework"],
        "ninja_targets": {
          "add": ["flutter/lib/snapshot:generate_snapshot_bins"],
          "why": "What this shard's artifacts, composes or later steps need that upstream's build doesn't list."
        }
      },
      {
        "type": "shell",
        "command": "flutter/bin/et stamp && cp out/engine_stamp.json out/ci/host_release/engine_stamp.json"
      }
    ],
    "compose_input": "macos-framework",
    "artifacts": [
      {"src": "host_release/dart-sdk", "dst": "flutter_infra_release/flutter/$engine/dart-sdk-darwin-x64.zip", "zip": true, "content_hash": true},
      {"src": "ci/host_release/zip_archives/darwin-x64/font-subset.zip", "dst": "flutter_infra_release/flutter/$engine/darwin-x64/font-subset.zip"},
      {"src": "ci/host_release/engine_stamp.json", "dst": "flutter_infra_release/flutter/$engine/engine_stamp.json"},
      {"src": "ci/host_release/analyze_snapshot_x64", "dst": "shorebird/$engine/analyze-snapshot-macos-x64"}
    ]
  },
