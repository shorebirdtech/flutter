  "ios": {
    "steps": [
      {
        "type": "builder",
        "builds": ["mac_ios_engine/ci/ios_release"],
        "gn_args": {
          "add": ["--gn-arg=shorebird_include_mixed_mode=true"],
          "why": "Shorebird: the iOS release engine runs patches in mixed mode (interpreted and AOT code)."
        }
      },
      {"type": "verify_exported"},
      {
        "type": "builder",
        "builds": ["mac_ios_engine/ci/ios_debug_sim"],
        "ninja_targets": {
          "add": ["flutter/shell/platform/darwin/ios:flutter_framework", "flutter/lib/snapshot:generate_snapshot_bins"],
          "remove": ["default"],
          "why": "Upstream builds the default target (everything); we build only what this shard publishes or a compose reads. What this shard's artifacts, composes or later steps need that upstream's build doesn't list."
        }
      },
      {
        "type": "clang_tidy",
        "out_dir": "ci/ios_debug_sim"
      },
      {
        "type": "builder",
        "builds": ["mac_ios_engine/ci/ios_debug_sim_arm64"],
        "ninja_targets": {
          "add": ["flutter/shell/platform/darwin/ios:flutter_framework", "flutter/lib/snapshot:generate_snapshot_bins"],
          "remove": ["default"],
          "why": "Upstream builds the default target (everything); we build only what this shard publishes or a compose reads. What this shard's artifacts, composes or later steps need that upstream's build doesn't list."
        }
      }
    ],
    "compose_input": "ios-framework"
  },
  "ios-debug": {
    "steps": [
