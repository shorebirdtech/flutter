{
  "android-arm64": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_android_aot_engine/ci\\android_release_arm64"]
      },
      {
        "type": "builder",
        "builds": ["windows_android_aot_engine/ci\\android_profile_arm64"]
      }
    ],
    "artifacts": [
      {"src": "ci/android_release_arm64/zip_archives/android-arm64-release/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-arm64-release/windows-x64.zip"},
      {"src": "ci/android_profile_arm64/zip_archives/android-arm64-profile/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-arm64-profile/windows-x64.zip"}
    ]
  },
  "android-arm32": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_android_aot_engine/ci\\android_release"]
      },
      {
        "type": "builder",
        "builds": ["windows_android_aot_engine/ci\\android_profile"]
      }
    ],
    "artifacts": [
      {"src": "ci/android_release/zip_archives/android-arm-release/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-arm-release/windows-x64.zip"},
      {"src": "ci/android_profile/zip_archives/android-arm-profile/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-arm-profile/windows-x64.zip"}
    ]
  },
  "android-x64": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_android_aot_engine/ci\\android_release_x64"]
      },
      {
        "type": "builder",
        "builds": ["windows_android_aot_engine/ci\\android_profile_x64"]
      }
    ],
    "artifacts": [
      {"src": "ci/android_release_x64/zip_archives/android-x64-release/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-x64-release/windows-x64.zip"},
      {"src": "ci/android_profile_x64/zip_archives/android-x64-profile/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-x64-profile/windows-x64.zip"}
    ]
  },
  "host-release": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_host_engine/ci\\host_release"],
        "ninja_targets": {
          "add": ["dart_sdk", "flutter/build/archives:artifacts", "flutter/tools/font_subset"],
          "why": "What this shard's artifacts, composes or later steps need that upstream's build doesn't list."
        }
      }
    ],
    "artifacts": [
      {"src": "ci/host_release/dart-sdk", "dst": "flutter_infra_release/flutter/$engine/dart-sdk-windows-x64.zip", "zip": true, "content_hash": true},
      {"src": "ci/host_release/zip_archives/windows-x64/font-subset.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64/font-subset.zip"},
      {"src": "ci/host_release/zip_archives/windows-x64-release/windows-x64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64-release/windows-x64-flutter.zip"}
    ]
  },
  "host-debug": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_host_engine/ci\\host_debug"],
        "ninja_targets": {
          "remove": ["flutter/build/archives:embedder", "flutter/tools/font_subset", "flutter/build/archives:dart_sdk_archive", "flutter/impeller/toolkit/interop:sdk"],
          "why": "Not published from this shard (its artifacts and composes say what is), so not worth the compile minutes."
        }
      }
    ],
    "artifacts": [
      {"src": "ci/host_debug/zip_archives/windows-x64/artifacts.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64/artifacts.zip"},
      {"src": "ci/host_debug/zip_archives/windows-x64-debug/windows-x64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64-debug/windows-x64-flutter.zip"},
      {"src": "ci/host_debug/zip_archives/windows-x64/flutter-cpp-client-wrapper.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64/flutter-cpp-client-wrapper.zip"}
    ]
  },
  "host-profile": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_host_engine/ci\\host_profile"]
      }
    ],
    "artifacts": [
      {"src": "ci/host_profile/zip_archives/windows-x64-profile/windows-x64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64-profile/windows-x64-flutter.zip"}
    ]
  },
  "host-arm64-debug": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_arm_host_engine/ci\\host_debug_arm64"],
        "ninja_targets": {
