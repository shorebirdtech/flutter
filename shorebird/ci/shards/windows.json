{
  "android-arm64": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--android", "--android-cpu=arm64", "--runtime-mode=release"],
        "ninja_targets": ["archive_win_gen_snapshot"],
        "out_dir": "android_release_arm64"
      },
      {
        "type": "gn_ninja",
        "gn_args": ["--android", "--android-cpu=arm64", "--runtime-mode=profile"],
        "ninja_targets": ["archive_win_gen_snapshot"],
        "out_dir": "android_profile_arm64"
      }
    ],
    "artifacts": [
      {"src": "android_release_arm64/zip_archives/android-arm64-release/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-arm64-release/windows-x64.zip"},
      {"src": "android_profile_arm64/zip_archives/android-arm64-profile/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-arm64-profile/windows-x64.zip"}
    ]
  },
  "android-arm32": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--android", "--runtime-mode=release"],
        "ninja_targets": ["archive_win_gen_snapshot"],
        "out_dir": "android_release"
      },
      {
        "type": "gn_ninja",
        "gn_args": ["--android", "--runtime-mode=profile"],
        "ninja_targets": ["archive_win_gen_snapshot"],
        "out_dir": "android_profile"
      }
    ],
    "artifacts": [
      {"src": "android_release/zip_archives/android-arm-release/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-arm-release/windows-x64.zip"},
      {"src": "android_profile/zip_archives/android-arm-profile/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-arm-profile/windows-x64.zip"}
    ]
  },
  "android-x64": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--android", "--android-cpu=x64", "--runtime-mode=release"],
        "ninja_targets": ["archive_win_gen_snapshot"],
        "out_dir": "android_release_x64"
      },
      {
        "type": "gn_ninja",
        "gn_args": ["--android", "--android-cpu=x64", "--runtime-mode=profile"],
        "ninja_targets": ["archive_win_gen_snapshot"],
        "out_dir": "android_profile_x64"
      }
    ],
    "artifacts": [
      {"src": "android_release_x64/zip_archives/android-x64-release/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-x64-release/windows-x64.zip"},
      {"src": "android_profile_x64/zip_archives/android-x64-profile/windows-x64.zip", "dst": "flutter_infra_release/flutter/$engine/android-x64-profile/windows-x64.zip"}
    ]
  },
  "host-release": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--runtime-mode=release", "--no-prebuilt-dart-sdk"],
        "ninja_targets": ["dart_sdk", "flutter/build/archives:windows_flutter", "gen_snapshot", "windows", "flutter/build/archives:artifacts"],
        "out_dir": "host_release"
      }
    ],
    "artifacts": [
      {"src": "host_release/dart-sdk", "dst": "flutter_infra_release/flutter/$engine/dart-sdk-windows-x64.zip", "zip": true, "content_hash": true},
      {"src": "host_release/zip_archives/windows-x64-release/windows-x64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64-release/windows-x64-flutter.zip"}
    ]
  },
  "host-debug": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--no-prebuilt-dart-sdk"],
        "ninja_targets": ["flutter/build/archives:artifacts", "flutter/build/archives:windows_flutter", "flutter/shell/platform/windows/client_wrapper:client_wrapper_archive"],
        "out_dir": "host_debug"
      }
    ],
    "artifacts": [
      {"src": "host_debug/zip_archives/windows-x64/artifacts.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64/artifacts.zip"},
      {"src": "host_debug/zip_archives/windows-x64-debug/windows-x64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64-debug/windows-x64-flutter.zip"},
      {"src": "host_debug/zip_archives/windows-x64/flutter-cpp-client-wrapper.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64/flutter-cpp-client-wrapper.zip"}
    ]
  },
  "host-profile": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--runtime-mode=profile", "--no-prebuilt-dart-sdk"],
        "ninja_targets": ["flutter/build/archives:windows_flutter", "gen_snapshot", "windows"],
        "out_dir": "host_profile"
      }
    ],
    "artifacts": [
      {"src": "host_profile/zip_archives/windows-x64-profile/windows-x64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-x64-profile/windows-x64-flutter.zip"}
    ]
  },
  "host-arm64-debug": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--no-lto", "--windows-cpu", "arm64"],
        "ninja_targets": ["dart_sdk", "flutter/build/archives:artifacts", "flutter/tools/font_subset", "flutter/shell/platform/windows/client_wrapper:client_wrapper_archive", "flutter/build/archives:windows_flutter"],
        "out_dir": "host_debug_arm64"
      }
    ],
    "artifacts": [
      {"src": "host_debug_arm64/dart-sdk", "dst": "flutter_infra_release/flutter/$engine/dart-sdk-windows-arm64.zip", "zip": true, "content_hash": true},
      {"src": "host_debug_arm64/zip_archives/windows-arm64/artifacts.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64/artifacts.zip"},
      {"src": "host_debug_arm64/zip_archives/windows-arm64/font-subset.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64/font-subset.zip"},
      {"src": "host_debug_arm64/zip_archives/windows-arm64-debug/windows-arm64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64-debug/windows-arm64-flutter.zip"},
      {"src": "host_debug_arm64/zip_archives/windows-arm64/flutter-cpp-client-wrapper.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64/flutter-cpp-client-wrapper.zip"}
    ]
  },
  "host-arm64-profile": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--runtime-mode=profile", "--no-lto", "--windows-cpu", "arm64"],
        "ninja_targets": ["windows", "gen_snapshot", "flutter/build/archives:windows_flutter"],
        "out_dir": "host_profile_arm64"
      }
    ],
    "artifacts": [
      {"src": "host_profile_arm64/zip_archives/windows-arm64-profile/windows-arm64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64-profile/windows-arm64-flutter.zip"}
    ]
  },
  "host-arm64-release": {
    "steps": [
      {
        "type": "gn_ninja",
        "gn_args": ["--runtime-mode=release", "--no-lto", "--windows-cpu", "arm64"],
        "ninja_targets": ["windows", "gen_snapshot", "flutter/build/archives:windows_flutter"],
        "out_dir": "host_release_arm64"
      }
    ],
    "artifacts": [
      {"src": "host_release_arm64/zip_archives/windows-arm64-release/windows-arm64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64-release/windows-arm64-flutter.zip"}
    ]
  }
}
