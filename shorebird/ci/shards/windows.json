          "why": "Not published from this shard (its artifacts and composes say what is), so not worth the compile minutes. What this shard's artifacts, composes or later steps need that upstream's build doesn't list."
        }
      }
    ],
    "artifacts": [
      {"src": "ci/host_debug_arm64/dart-sdk", "dst": "flutter_infra_release/flutter/$engine/dart-sdk-windows-arm64.zip", "zip": true},
      {"src": "ci/host_debug_arm64/zip_archives/windows-arm64/artifacts.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64/artifacts.zip"},
      {"src": "ci/host_debug_arm64/zip_archives/windows-arm64/font-subset.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64/font-subset.zip"},
      {"src": "ci/host_debug_arm64/zip_archives/windows-arm64-debug/windows-arm64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64-debug/windows-arm64-flutter.zip"},
      {"src": "ci/host_debug_arm64/zip_archives/windows-arm64/flutter-cpp-client-wrapper.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64/flutter-cpp-client-wrapper.zip"}
    ]
  },
  "host-arm64-profile": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_arm_host_engine/ci\\host_profile_arm64"]
      }
    ],
    "artifacts": [
      {"src": "ci/host_profile_arm64/zip_archives/windows-arm64-profile/windows-arm64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64-profile/windows-arm64-flutter.zip"}
    ]
  },
  "host-arm64-release": {
    "steps": [
      {
        "type": "builder",
        "builds": ["windows_arm_host_engine/ci\\host_release_arm64"]
      }
    ],
    "artifacts": [
      {"src": "ci/host_release_arm64/zip_archives/windows-arm64-release/windows-arm64-flutter.zip", "dst": "flutter_infra_release/flutter/$engine/windows-arm64-release/windows-arm64-flutter.zip"}
